# Copy to .env and fill in. NEVER commit .env. All values below are TESTNET only.
# Owner Concordium testnet account (Base58, from Browser Wallet, testnet network).
CCD_OWNER_ACCOUNT=
# Testnet account for the x402 demo client (buyer side) — Ed25519 private key, hex.
# Generated for the demo only; testnet only; never reuse a mainnet key.
CCD_DEMO_PRIVATE_KEY=
CCD_DEMO_ADDRESS=
# Facilitator sponsor account (pays network fees for sponsored txs). Testnet only.
CCD_FACILITATOR_ADDRESS=
CCD_FACILITATOR_PRIVATE_KEY=
# Where the Agent Card is hosted (must be public and byte-stable).
AGENT_CARD_URL=https://ubattronjol.github.io/concordium-abogo/.well-known/agent-card.json
# x402 server port (local demo).
X402_PORT=4021
